___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Trackable CMP — the web GTM tag (Consent Initialization - All Pages).
// For sites that load GTM themselves: GTM runs this before any other tag, so it
// sets the Consent Mode and UET defaults, then loads the CMP, which owns the
// banner and every later update. A stored choice is the default (lesson B2).
// If the CMP's own snippet already ran in <head>, it set the defaults first and
// this tag does nothing.
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const getCookieValues = require('getCookieValues');
const fromBase64 = require('fromBase64');
const JSON = require('JSON');
const getType = require('getType');
const getTimestampMillis = require('getTimestampMillis');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const createQueue = require('createQueue');
const callInWindow = require('callInWindow');
const injectScript = require('injectScript');
const queryPermission = require('queryPermission');
const logToConsole = require('logToConsole');

const CATEGORIES = ['functionality', 'experience', 'measurement', 'marketing'];
const SIGNALS = {
  functionality: ['functionality_storage'],
  experience: ['personalization_storage'],
  measurement: ['analytics_storage'],
  marketing: ['ad_storage', 'ad_user_data', 'ad_personalization'],
};

function modeState(on) {
  const out = { security_storage: 'granted' };
  for (let i = 0; i < CATEGORIES.length; i++) {
    const s = SIGNALS[CATEGORIES[i]];
    for (let j = 0; j < s.length; j++) out[s[j]] = on[CATEGORIES[i]] ? 'granted' : 'denied';
  }
  return out;
}

function decodeBody(body) {
  let s = body.split('-').join('+').split('_').join('/');
  while (s.length % 4 !== 0) s = s + '=';
  const text = fromBase64(s);
  return text ? JSON.parse(text) : undefined;
}

// The visitor's stored choice from tc_consent, if valid here: same rules as the
// CMP's stub (consent version, lifetime, not from the future). The CMP checks
// again when it loads and corrects the state if this copy of the settings is old.
// A cookie that cannot be read is skipped, never an error: an error here would leave no default at all.
function storedChoice(gpcUnknown) {
  if (data.useStoredChoice === false) return null;
  const version = makeNumber(data.consentVersion || 0);
  // An unreadable version: no stored choice counts (the CMP decides when it loads).
  if (version !== version) return null;
  const values = getCookieValues('tc_consent') || [];
  const lifetime = (makeNumber(data.lifetimeDays || 365) || 365) * 86400000;
  const now = getTimestampMillis();
  for (let i = 0; i < values.length; i++) {
    const raw = makeString(values[i] || '');
    if (!raw) continue;
    const p = decodeBody(raw.split('.')[0]);
    if (getType(p) !== 'object' || getType(p.c) !== 'object' || getType(p.t) !== 'number') continue;
    if ((p.cfg || 0) < version || now - p.t > lifetime || p.t > now + 600000) continue;
    const on = {};
    for (let j = 0; j < CATEGORIES.length; j++) on[CATEGORIES[j]] = p.c[CATEGORIES[j]] === 1;
    // US: GTM cannot read the browser's opt-out signal (GPC), and it may now be on: a US choice made
    // without it waits for the banner, which reads it and updates (fail towards compliance).
    if (gpcUnknown && p.oo === 1 && p.gpc !== 1) { on.measurement = false; on.marketing = false; }
    return on;
  }
  return null;
}

// GPC is an opt-out in US rows. Templates may not read navigator, so in US rows analytics and marketing
// start denied and the banner, which reads GPC, grants them for visitors who do not send it.
function usRow(regions) {
  if (regions.length === 0) return false;
  for (let i = 0; i < regions.length; i++) if (regions[i].substring(0, 2) !== 'US') return false;
  return true;
}

function rowsFromTable(gpcUnknown) {
  const rows = [];
  const table = data.defaults || [];
  for (let i = 0; i < table.length; i++) {
    const r = table[i];
    const regions = [];
    const parts = makeString(r.region || '').split(',');
    for (let j = 0; j < parts.length; j++) {
      const code = parts[j].trim().toUpperCase();
      if (code) regions.push(code);
    }
    const on = {};
    for (let j = 0; j < CATEGORIES.length; j++) on[CATEGORIES[j]] = r[CATEGORIES[j]] === 'granted';
    if (gpcUnknown && usRow(regions)) { on.measurement = false; on.marketing = false; }
    rows.push({ regions: regions, on: on });
  }
  return rows;
}

// A site's own /_tc/ address this template may not load from (its permissions cover only some
// domains): the same loader from our host in hybrid mode, so the banner always loads.
function loaderAllowed(url) {
  if (queryPermission('inject_script', url)) return url;
  const at = url.indexOf('/_tc/l/');
  if (at < 0) return url;
  return 'https://cmp.trackable.digital/l/' + url.substring(at + 7).split('?')[0] + '?so=1';
}

function uet(state) {
  if (data.uet === false) return;
  createQueue('uetq');
  callInWindow('uetq.push', 'consent', 'default', { ad_storage: state });
}

if (copyFromWindow('__tcState')) {
  // The CMP's snippet is on the page and went first: nothing to do.
  data.gtmOnSuccess();
} else {
  const wait = makeNumber(data.waitForUpdate || 500) || 500;
  const gpcUnknown = data.honourGpc !== false;
  const stored = storedChoice(gpcUnknown);
  const rows = rowsFromTable(gpcUnknown);
  if (stored) {
    // One default for everyone: a region row would outrank it in GTM.
    const mode = modeState(stored);
    mode.wait_for_update = wait;
    setDefaultConsentState(mode);
    // Also an immediate update, as the CMP's snippet sends: same state, nothing fires twice.
    updateConsentState(modeState(stored));
    uet(stored.marketing ? 'granted' : 'denied');
  } else {
    // Rows without a region are the fallback. Nothing in the table: everything denied.
    let fallback = { functionality: false, experience: false, measurement: false, marketing: false };
    for (let i = 0; i < rows.length; i++) if (rows[i].regions.length === 0) fallback = rows[i].on;
    const base = modeState(fallback);
    base.wait_for_update = wait;
    setDefaultConsentState(base);
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].regions.length === 0) continue;
      const m = modeState(rows[i].on);
      m.region = rows[i].regions;
      m.wait_for_update = wait;
      setDefaultConsentState(m);
    }
    // UET has no regions: granted only if every row grants marketing, so no region gets more than its row.
    let allMarketing = fallback.marketing;
    for (let i = 0; i < rows.length; i++) if (!rows[i].on.marketing) allMarketing = false;
    uet(allMarketing ? 'granted' : 'denied');
  }
  const settings = {};
  if (data.adsDataRedaction) settings.ads_data_redaction = true;
  if (data.urlPassthrough) settings.url_passthrough = true;
  if (data.developerId) settings['developer_id.' + makeString(data.developerId)] = true;
  if (data.adsDataRedaction || data.urlPassthrough || data.developerId) gtagSet(settings);

  // What this tag applied, so the CMP sends an update only where its own view differs
  // (its region comes from our edge, GTM's from Google). `s`: a stored choice applied to all.
  const applied = { s: stored, r: [] };
  for (let i = 0; i < rows.length; i++) applied.r.push([rows[i].regions.join(','), rows[i].on]);
  setInWindow('__tcTag', applied, true);

  const url = makeString(data.loaderUrl || '');
  if (!url) {
    logToConsole('Trackable CMP: no loader address set');
    data.gtmOnFailure();
  } else {
    injectScript(loaderAllowed(url), data.gtmOnSuccess, data.gtmOnFailure);
  }
}


