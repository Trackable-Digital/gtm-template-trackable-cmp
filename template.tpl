___TESTS___

scenarios:
- name: "First visit, a default per region and the fallback, no update, then loads the banner"
  code: |-
    const mockData = {
      loaderUrl: 'https://cmp.trackable.digital/l/acme-shop.js',
      defaults: [
        { region: 'GB,FR,DE', functionality: 'granted', experience: 'denied', measurement: 'denied', marketing: 'denied' },
        { region: 'US', functionality: 'granted', experience: 'granted', measurement: 'granted', marketing: 'granted' },
        { region: '', functionality: 'granted', experience: 'denied', measurement: 'denied', marketing: 'denied' }
      ],
      useStoredChoice: true, consentVersion: '1', lifetimeDays: '365', honourGpc: true, uet: true,
      adsDataRedaction: false, urlPassthrough: false, developerId: '', waitForUpdate: '500'
    };
